{
  "name": "macPuTTY",
  "productName": "MacPuTTY",
  "version": "1.0.0",
  "description": "A small SSH key generator and inspector, backed by a local Flask API.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ayaans16.macputty",
    "productName": "MacPuTTY",
    "directories": { "output": "../dist" },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "package.json"
    ],
    "extraResources": [
      { "from": "resources/backend/macputty-backend", "to": "backend/macputty-backend" }
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "MacPuTTY ${version}"
    }
  }
}